# ─── Contact form delivery (SMTP) ────────────────────────────────────────────
# Copy to `.env.local` for local dev, and add the same four SMTP_* vars plus
# CONTACT_TO in your Vercel project settings (Settings → Environment Variables).
#
# WITHOUT THESE, THE FORM DOES NOT SEND. It will tell the visitor so and show
# them the direct email address instead — but nothing reaches your inbox. This
# is exactly what was silently happening on the previous version of this site.
#
# After setting them in Vercel you must redeploy; environment variables are
# baked in at build time and an existing deployment will not pick them up.

# Where enquiries are delivered — your inbox.
CONTACT_TO=starsalman01@gmail.com

# What the email is sent "from". Usually the same as SMTP_USER; some providers
# reject a from-address that is not the authenticated account.
CONTACT_FROM=starsalman01@gmail.com

# ── Option A: Gmail with an App Password ──
# Requires 2FA on the account. Create one at:
#   https://myaccount.google.com/apppasswords
# Use the 16-character app password, NOT your normal Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=starsalman01@gmail.com
SMTP_PASS=your-16-char-app-password

# ── Option B: Mailgun ──
# Better deliverability than Gmail for form mail, and it will not rate-limit
# you. Credentials from Mailgun → Sending → Domain settings → SMTP credentials.
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@mg.dragondevs.co
# SMTP_PASS=your-mailgun-smtp-password

# ── Option C: Resend over SMTP ──
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your-resend-api-key
